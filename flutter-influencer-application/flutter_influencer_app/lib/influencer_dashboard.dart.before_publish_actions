  // ============================================================
  // LOAD DASHBOARD
  // ============================================================

  Future<void> _loadDashboard() async {
    setState(() {
      _isLoading = true;
      _errorMessage = null;

      // Reset pagination
      _campaignPage = 1;
      _submissionPage = 1;

      _campaignTotalPages = 1;
      _submissionTotalPages = 1;

      // Reset displayed records
      _campaigns = [];
      _submissions = [];

      // Reset complete statistics
      _totalCampaigns = 0;
      _totalSubmissions = 0;
      _totalEarnings = 0;
    });

    try {
      final results = await Future.wait([
        ApiService.getCampaigns(
          page: 1,
          limit: _pageLimit,
        ),
        ApiService.getMySubmissionLogs(
          page: 1,
          limit: _pageLimit,
        ),
      ]);

      final campaignsResult =
          results[0];

      final submissionsResult =
          results[1];

      if (!mounted) return;

      // ========================================================
      // CAMPAIGN PAGE ITEMS
      // ========================================================

      final campaignItems =
          campaignsResult['items'] is List
              ? List<dynamic>.from(
                  campaignsResult['items'],
                )
              : <dynamic>[];

      // ========================================================
      // SUBMISSION PAGE ITEMS
      // ========================================================

      final submissionItems =
          submissionsResult['items'] is List
              ? List<dynamic>.from(
                  submissionsResult['items'],
                )
              : <dynamic>[];

      // ========================================================
      // COMPLETE CAMPAIGN TOTAL
      // ========================================================

      final campaignTotal =
          int.tryParse(
                campaignsResult['total']
                        ?.toString() ??
                    '0',
              ) ??
              0;

      // ========================================================
      // COMPLETE SUBMISSION TOTAL
      // ========================================================

      final submissionTotal =
          int.tryParse(
                submissionsResult['total']
                        ?.toString() ??
                    '0',
              ) ??
              0;

      // ========================================================
      // COMPLETE APPROVED EARNINGS
      // Returned by backend independently of pagination.
      // ========================================================

      final approvedEarnings =
          double.tryParse(
                submissionsResult[
                            'approved_earnings']
                        ?.toString() ??
                    '0',
              ) ??
              0;

      // ========================================================
      // STORED USER
      // ========================================================

      final tokenUser =
          await _getStoredUser();

      // ========================================================
      // UPDATE STATE
      // ========================================================

      setState(() {
        // Current page records
        _campaigns = campaignItems;
        _submissions = submissionItems;

        // Complete statistics
        _totalCampaigns =
            campaignTotal;

        _totalSubmissions =
            submissionTotal;

        _totalEarnings =
            approvedEarnings;

        // Pagination
        _campaignTotalPages =
            _calculateTotalPages(
          campaignTotal,
        );

        _submissionTotalPages =
            _calculateTotalPages(
          submissionTotal,
        );

        if (tokenUser != null &&
            tokenUser['name'] != null) {
          _creatorName =
              tokenUser['name'].toString();
        }

        _isLoading = false;
      });
    } catch (e) {
      if (!mounted) return;

      setState(() {
        _errorMessage =
            'Failed to load dashboard: $e';

        _isLoading = false;
      });
    }
  }

  // ============================================================
  // CALCULATE TOTAL PAGES
  // ============================================================

  int _calculateTotalPages(
    int total,
  ) {
    if (total <= 0) {
      return 1;
    }

    return (total + _pageLimit - 1) ~/
        _pageLimit;
  }

  // ============================================================
  // CHANGE CAMPAIGN PAGE
  // ============================================================

  Future<void> _changeCampaignPage(
    int page,
  ) async {
    if (_isChangingCampaignPage) {
      return;
    }

    if (page < 1 ||
        page > _campaignTotalPages ||
        page == _campaignPage) {
      return;
    }

    setState(() {
      _isChangingCampaignPage = true;
    });

    try {
      final result =
          await ApiService.getCampaigns(
        page: page,
        limit: _pageLimit,
      );

      if (!mounted) return;

      final items =
          result['items'] is List
              ? List<dynamic>.from(
                  result['items'],
                )
              : <dynamic>[];

      final total =
          int.tryParse(
                result['total']
                        ?.toString() ??
                    '0',
              ) ??
              0;

      setState(() {
        _campaigns = items;

        _campaignPage = page;

        _campaignTotalPages =
            _calculateTotalPages(
          total,
        );

        // IMPORTANT:
        // Do NOT change _totalCampaigns here.
        // Statistics remain complete totals.

        _isChangingCampaignPage = false;
      });
    } catch (e) {
      if (!mounted) return;

      setState(() {
        _isChangingCampaignPage = false;
      });

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(
            'Failed to load campaigns: $e',
          ),
        ),
      );
    }
  }

  // ============================================================
  // CHANGE SUBMISSION PAGE
  // ============================================================

  Future<void> _changeSubmissionPage(
    int page,
  ) async {
    if (_isChangingSubmissionPage) {
      return;
    }

    if (page < 1 ||
        page > _submissionTotalPages ||
        page == _submissionPage) {
      return;
    }

    setState(() {
      _isChangingSubmissionPage = true;
    });

    try {
      final result =
          await ApiService.getMySubmissionLogs(
        page: page,
        limit: _pageLimit,
      );

      if (!mounted) return;

      final items =
          result['items'] is List
              ? List<dynamic>.from(
                  result['items'],
                )
              : <dynamic>[];

      final total =
          int.tryParse(
                result['total']
                        ?.toString() ??
                    '0',
              ) ??
              0;

      setState(() {
        _submissions = items;

        _submissionPage = page;

        _submissionTotalPages =
            _calculateTotalPages(
          total,
        );

        // IMPORTANT:
        // Do NOT change _totalSubmissions or
        // _totalEarnings here.
        // Statistics remain complete totals.

        _isChangingSubmissionPage =
            false;
      });
    } catch (e) {
      if (!mounted) return;

      setState(() {
        _isChangingSubmissionPage = false;
      });

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(
            'Failed to load submissions: $e',
          ),
        ),
      );
    }
  }

  // ============================================================
