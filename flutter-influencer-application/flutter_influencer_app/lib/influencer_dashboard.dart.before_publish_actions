  // ============================================================
  // LOAD AFFILIATE PROGRAMS
  // ============================================================

  Future<void> _loadAffiliatePrograms({
    int page = 1,
  }) async {
    setState(() {
      _isLoadingAffiliatePrograms = true;
    });

    try {
      final results = await Future.wait([
        ApiService.getAffiliatePrograms(
          page: page,
          limit: _affiliateProgramPageLimit,
        ),
        ApiService.getMyAffiliatePrograms(),
      ]);

      final programsResult = results[0];
      final membershipsResult = results[1];

      debugPrint(
        'MY AFFILIATE PROGRAMS RESPONSE: $membershipsResult',
      );

      final programs =
          programsResult['programs'] is List
              ? List<dynamic>.from(
                  programsResult['programs'],
                )
              : <dynamic>[];

      final memberships =
          membershipsResult['programs'] is List
              ? List<dynamic>.from(
                  membershipsResult['programs'],
                )
              : <dynamic>[];

      final Map<int, String> statuses = {};

      for (final membership in memberships) {
        if (membership is! Map) {
          continue;
        }

        final programId = membership['program_id'];

        if (programId == null) {
          continue;
        }

        final parsedProgramId =
            int.tryParse(programId.toString());

        if (parsedProgramId == null) {
          continue;
        }

        statuses[parsedProgramId] =
            membership['membership_status']
                    ?.toString()
                    .toLowerCase() ??
                membership['status']
                    ?.toString()
                    .toLowerCase() ??
                'pending';
      }

      if (!mounted) return;

      setState(() {
        _affiliatePrograms = programs;

        _myAffiliatePrograms = memberships;

        _affiliateProgramStatuses = statuses;

        _affiliateProgramPage =
            (programsResult['page'] as num?)?.toInt() ??
                page;

        _affiliateProgramTotalPages =
            (programsResult['total_pages'] as num?)?.toInt() ??
                1;

        _affiliateProgramTotal =
            (programsResult['total'] as num?)?.toInt() ??
                0;

        _isLoadingAffiliatePrograms = false;
      });
    } catch (e) {
      if (!mounted) return;

      setState(() {
        _isLoadingAffiliatePrograms = false;
      });

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(
            'Unable to load Affiliate Programs: $e',
          ),
        ),
      );
    }
  }

  // ============================================================
  // CHANGE AFFILIATE PROGRAM PAGE
  // ============================================================

  Future<void> _changeAffiliateProgramPage(
    int page,
  ) async {
    if (_isChangingAffiliateProgramPage) {
      return;
    }

    if (page < 1 ||
        page > _affiliateProgramTotalPages ||
        page == _affiliateProgramPage) {
      return;
    }

    setState(() {
      _isChangingAffiliateProgramPage = true;
    });

    try {
      await _loadAffiliatePrograms(
        page: page,
      );
    } finally {
      if (mounted) {
        setState(() {
          _isChangingAffiliateProgramPage = false;
        });
      }
    }
  }

  // ============================================================
  // CREATOR ELIGIBILITY
  // ============================================================

  bool _isCreatorEligible(dynamic value) {
    final String v =
        value?.toString().toLowerCase().trim() ?? '';

    return v == '1' ||
        v == 'true' ||
        v == 'yes' ||
        v == 'eligible';
  }

// ============================================================
// JOIN AFFILIATE PROGRAM
// ============================================================

Future<void> _joinAffiliateProgram({
  required int programId,
  required dynamic program,
}) async {
  final String brandName =
      program['brand_name']?.toString() ?? '';

  final String programName =
      program['program_name']?.toString() ?? '';

  final bool? confirmed =
      await showDialog<bool>(
    context: context,
    builder: (context) {
      return AlertDialog(
        title: const Text(
          'Join Affiliate Program',
        ),
        content: Text(
          'Do you want to join the '
          '$brandName $programName affiliate program?',
        ),
        actions: [
          TextButton(
            onPressed: () {
              Navigator.pop(
                context,
                false,
              );
            },
            child: const Text('Cancel'),
          ),
          ElevatedButton(
            onPressed: () {
              Navigator.pop(
                context,
                true,
              );
            },
            child: const Text('Join'),
          ),
        ],
      );
    },
  );

  if (confirmed != true) {
    return;
  }

  if (!mounted) return;

  // ============================================================
  // CHECK EXISTING MEMBERSHIP STATUS
  // ============================================================

  final existingStatus =
      _affiliateProgramStatuses[programId]
          ?.toLowerCase();

  if (existingStatus == 'pending') {
    ScaffoldMessenger.of(context).showSnackBar(
      const SnackBar(
        content: Text(
          'Your application for this affiliate program is already pending.',
        ),
      ),
    );
    return;
  }

  if (existingStatus == 'active') {
    ScaffoldMessenger.of(context).showSnackBar(
      const SnackBar(
        content: Text(
          'You are already an active member of this affiliate program.',
        ),
      ),
    );
    return;
  }

  // ============================================================
  // JOIN PROGRAM
  // ============================================================

  try {
    final result =
        await ApiService.joinAffiliateProgram(
      programId: programId,
    );

    if (!mounted) return;

    setState(() {
      _affiliateProgramStatuses[programId] =
          'pending';
    });

    final returnedStatus =
        result['membership']?['status']
            ?.toString();

    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: Text(
          returnedStatus != null &&
                  returnedStatus.isNotEmpty
              ? 'Affiliate program joined. '
                'Status: $returnedStatus'
              : 'Affiliate program joined. '
                'Status: Pending',
        ),
      ),
    );
  } catch (e) {
    if (!mounted) return;

    // ==========================================================
    // FRIENDLY DUPLICATE / ERROR MESSAGE
    // ==========================================================

    final errorText =
        e.toString().toLowerCase();

    String message =
        'Unable to join affiliate program.';

    if (errorText.contains('already') ||
        errorText.contains('duplicate')) {
      message =
          'You have already joined this affiliate program.';
    }

    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: Text(message),
      ),
    );
  }
}

