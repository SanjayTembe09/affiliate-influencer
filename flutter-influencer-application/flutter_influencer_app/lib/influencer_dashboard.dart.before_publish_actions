  Widget _buildMyAffiliateProgramCard(
    Map<String, dynamic> membership,
  ) {
    //final int? programId =
    //    int.tryParse(membership['program_id']?.toString() ?? '');

    final String brandName =
        membership['brand_name']?.toString() ?? 'Unknown Brand';

    final String programName =
        membership['program_name']?.toString() ?? 'Affiliate Program';

    final String category =
        membership['category']?.toString() ?? '';

    final String commissionType =
        membership['commission_type']?.toString() ?? '';

    final String commissionRate =
        membership['commission_rate']?.toString() ?? '';

    final String affiliateNetwork =
        membership['affiliate_network']?.toString() ?? '';

    final String membershipStatus =
        membership['membership_status']?.toString().toLowerCase() ??
            'pending';

    Color statusColor;
    Color statusBackground;

    switch (membershipStatus) {
      case 'active':
      case 'approved':
        statusColor = Colors.green.shade700;
        statusBackground = Colors.green.shade50;
        break;

      case 'rejected':
        statusColor = Colors.red.shade700;
        statusBackground = Colors.red.shade50;
        break;

      case 'pending':
      default:
        statusColor = Colors.orange.shade800;
        statusBackground = Colors.orange.shade50;
        break;
    }

    String statusLabel;

    switch (membershipStatus) {
      case 'active':
      case 'approved':
        statusLabel = 'Active';
        break;

      case 'rejected':
        statusLabel = 'Rejected';
        break;

      default:
        statusLabel = 'Pending';
        break;
    }

    return Card(
      margin: const EdgeInsets.only(bottom: 12),
      elevation: 1,
      shape: RoundedRectangleBorder(
        borderRadius: BorderRadius.circular(16),
      ),
      child: Padding(
