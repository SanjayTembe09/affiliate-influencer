  Future<void> _showAffiliateOfferDetails(
    Map<String, dynamic> offer,
  ) async {
      final int? offerId =
        int.tryParse(
      offer['offer_id']?.toString() ?? '',
    );

    final String brandName =
        offer['brand_name']?.toString() ?? 'Unknown Brand';

    final String title =
        offer['title']?.toString() ?? 'Affiliate Offer';

    final String description =
        offer['description']?.toString() ?? '';

    final String commissionType =
        offer['commission_type']?.toString() ?? '';

    final String commissionRate =
        offer['commission_rate']?.toString() ?? '';

    final String networkName =
        offer['affiliate_network']?.toString() ?? '';

    final String destinationUrl =
        offer['destination_url']?.toString() ?? '';

    final bool canGenerateLink =
        offer['can_generate_link'] == true;

    bool isGeneratingLink = false;
    String? generatedAffiliateUrl;
    String? linkError;

    final String? publishAffiliateUrl =
        await showDialog<String>(
      context: context,
      builder: (dialogContext) {
        return StatefulBuilder(
          builder: (
            context,
            setDialogState,
          ) {
            return AlertDialog(
              title: Text(
                '$brandName - Offer',
              ),

              content: SingleChildScrollView(
                child: Column(
                  mainAxisSize: MainAxisSize.min,
                  crossAxisAlignment:
                      CrossAxisAlignment.start,
                  children: [
                    Text(
                      title,
                      style: const TextStyle(
                        fontSize: 17,
                        fontWeight: FontWeight.bold,
                      ),
                    ),

                    if (description.isNotEmpty) ...[
                      const SizedBox(height: 12),
                      Text(description),
                    ],

                    const SizedBox(height: 16),

                    if (commissionRate.isNotEmpty)
                      _buildMyAffiliateProgramInfoRow(
                        Icons.payments_outlined,
                        commissionType.isNotEmpty
                            ? commissionType
                            : 'Commission',
                        commissionRate,
                      ),

                    if (networkName.isNotEmpty)
                      _buildMyAffiliateProgramInfoRow(
                        Icons.hub_outlined,
                        'Network',
                        networkName,
                      ),

                    if (generatedAffiliateUrl != null) ...[
                      const SizedBox(height: 18),

                      Container(
                        width: double.infinity,
                        padding:
                            const EdgeInsets.all(14),
                        decoration: BoxDecoration(
                          color: Colors.green
                              .withValues(alpha: 0.08),
                          borderRadius:
                              BorderRadius.circular(12),
                          border: Border.all(
                            color: Colors.green
                                .withValues(alpha: 0.25),
                          ),
                        ),
                        child: Column(
                          crossAxisAlignment:
                              CrossAxisAlignment.start,
                          children: [
                            Row(
                              children: [
                                const Icon(
                                  Icons.check_circle_outline,
                                  color: Colors.green,
                                  size: 20,
                                ),
                                const SizedBox(width: 8),
                                const Expanded(
                                  child: Text(
                                    'Affiliate Link Generated',
                                    style: TextStyle(
                                      fontWeight:
                                          FontWeight.bold,
                                      color: Colors.green,
                                    ),
                                  ),
                                ),
                              ],
                            ),

                            const SizedBox(height: 10),

                            SelectableText(
                              generatedAffiliateUrl!,
                              style: const TextStyle(
                                fontSize: 13,
                              ),
                            ),
                          ],
                        ),
                      ),
                    ],

                    if (linkError != null) ...[
                      const SizedBox(height: 12),

                      Text(
                        linkError!,
                        style: const TextStyle(
                          color: Colors.red,
                          fontSize: 13,
                        ),
                      ),
                    ],

                    if (destinationUrl.isNotEmpty) ...[
                      const SizedBox(height: 18),

                      _buildMyAffiliateProgramInfoRow(
                        Icons.open_in_new_outlined,
                        'Destination',
                        destinationUrl,
                      ),
                    ],
                  ],
                ),
              ),

              actions: [
                TextButton(
                  onPressed: isGeneratingLink
                      ? null
                      : () {
                          Navigator.of(
                            dialogContext,
                          ).pop();
                        },
                  child: const Text('Close'),
                ),

                if (generatedAffiliateUrl == null)
                  ElevatedButton.icon(
                    onPressed:
                        (!canGenerateLink ||
                                offerId == null ||
                                isGeneratingLink)
                            ? null
                            : () async {
                                setDialogState(() {
                                  isGeneratingLink = true;
                                  linkError = null;
                                });

                                try {
                                  final result =
                                      await ApiService
                                          .createAffiliateLink(
                                    offerId: offerId,
                                  );

                                  final link =
                                      result['link'];

                                  final String?
                                      affiliateUrl =
                                      link is Map
                                          ? link[
                                                  'affiliate_url']
                                              ?.toString()
                                          : null;

                                  if (affiliateUrl ==
                                          null ||
                                      affiliateUrl
                                          .isEmpty) {
                                    throw Exception(
                                      'Affiliate URL was not returned.',
                                    );
                                  }

                                  setDialogState(() {
                                    generatedAffiliateUrl =
                                        affiliateUrl;
                                    isGeneratingLink =
                                        false;
                                  });
                                } catch (e) {
                                  setDialogState(() {
                                    linkError =
                                        e.toString();
                                    isGeneratingLink =
                                        false;
                                  });
                                }
                              },
                    icon: isGeneratingLink
                        ? const SizedBox(
                            width: 18,
                            height: 18,
                            child:
                                CircularProgressIndicator(
                              strokeWidth: 2,
                            ),
                          )
                        : const Icon(
                            Icons.link_rounded,
                            size: 20,
                          ),
                    label: Text(
                      isGeneratingLink
                          ? 'Generating...'
                          : 'Generate Affiliate Link',
                    ),
                  ),
              ],
            );
          },
        );
      },
    );
  }


