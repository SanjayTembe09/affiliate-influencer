  // ============================================================
  // LOAD AFFILIATE EARNINGS
  // ============================================================

  Future<void> _loadAffiliateEarnings() async {
    if (!mounted) {
      return;
    }

    setState(() {
      _isLoadingAffiliateEarnings = true;
    });

    try {
      final result =
          await ApiService.getAffiliateEarnings();

      final summary =
          result['summary'] is List
              ? result['summary'] as List
              : <dynamic>[];

      if (summary.isNotEmpty &&
          summary.first is Map) {
        final firstSummary =
            Map<String, dynamic>.from(
          summary.first as Map,
        );

        if (!mounted) {
          return;
        }

        setState(() {
          _affiliateCurrency =
              firstSummary['currency']?.toString() ??
                  'INR';

          _affiliateTotalEarned =
              double.tryParse(
                firstSummary['total_earned']
                        ?.toString() ??
                    '0',
              ) ??
              0;

          _affiliatePending =
              double.tryParse(
                firstSummary['pending']
                        ?.toString() ??
                    '0',
              ) ??
              0;

          _affiliateAvailable =
              double.tryParse(
                firstSummary['available']
                        ?.toString() ??
                    '0',
              ) ??
              0;

          _affiliatePaid =
              double.tryParse(
                firstSummary['paid']
                        ?.toString() ??
                    '0',
              ) ??
              0;
        });
      } else {
        if (!mounted) {
          return;
        }

        setState(() {
          _affiliateCurrency = 'INR';
          _affiliateTotalEarned = 0;
          _affiliatePending = 0;
          _affiliateAvailable = 0;
          _affiliatePaid = 0;
        });
      }
    } catch (e) {
      debugPrint(
        'AFFILIATE EARNINGS LOAD ERROR: $e',
      );
    } finally {
      if (mounted) {
        setState(() {
          _isLoadingAffiliateEarnings = false;
        });
      }
    }
  }

  // ============================================================
  // REQUEST AFFILIATE PAYOUT
  // ============================================================

  Future<void> _requestAffiliatePayout({
    required double amount,
    required String paymentMethod,
    String? notes,
  }) async {
    try {
      final result = await ApiService.requestAffiliatePayout(
        amount: amount,
        currency: _affiliateCurrency,
        paymentMethod: paymentMethod,
        notes: notes,
      );

      if (!mounted) {
        return;
      }

      final message =
          result['message']?.toString() ??
          'Payout request created successfully.';

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(message),
        ),
      );

      // Refresh earnings so the newly reserved payout
      // is immediately reflected in Available balance.
      await _loadAffiliateEarnings();
    } catch (e) {
      if (!mounted) {
        return;
      }

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(
            'Unable to request payout: $e',
          ),
        ),
      );
    }
  }

