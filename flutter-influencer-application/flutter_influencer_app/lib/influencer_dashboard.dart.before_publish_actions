  // ============================================================

  Future<Map<String, dynamic>?>
      _getStoredUser() async {
    final prefs =
        await SharedPreferences
            .getInstance();

    final userJson =
        prefs.getString('user');

    if (userJson == null) {
      return null;
    }

    try {
      return Map<String, dynamic>.from(
        jsonDecode(userJson) as Map,
      );
    } catch (_) {
      return null;
    }
  }

