  Future<void> _loadMarketplaceProducts({
    int page = 1,
  }) async {
    if (page < 1 || page > _marketplaceTotalPages) {
      return;
    }

    setState(() {
      _isLoadingMarketplaceProducts = true;
      _isChangingMarketplacePage = true;
    });

    try {
      final result =
          await ApiService.getMarketplaceProducts(
        page: page,
        limit: _marketplacePageLimit,
      );

      if (!mounted) return;

      setState(() {
        _marketplaceProducts =
            List<dynamic>.from(result['products'] ?? []);

        _marketplacePage =
            (result['page'] as num?)?.toInt() ?? page;

        _marketplaceTotalPages =
            (result['total_pages'] as num?)?.toInt() ?? 1;

        _marketplaceTotalProducts =
            (result['total'] as num?)?.toInt() ?? 0;

        _isLoadingMarketplaceProducts = false;
        _isChangingMarketplacePage = false;
      });
    } catch (e) {
      if (!mounted) return;

      setState(() {
        _isLoadingMarketplaceProducts = false;
        _isChangingMarketplacePage = false;
      });

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(
            'Failed to load marketplace products: $e',
          ),
        ),
      );
    }
  }

